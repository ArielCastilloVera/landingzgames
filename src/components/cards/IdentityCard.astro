---
import BrandMark from '../ui/BrandMark.astro'; import ArrowIcon from '../ui/ArrowIcon.astro';
interface Props { label: string; footer: string; } const { label, footer } = Astro.props;
---
<article class="identity-card"><div class="identity-card__top"><span>{label}</span><span>WE BUILD TO WIN</span></div><div class="identity-card__mark"><BrandMark /></div><div class="identity-card__bottom"><span>{footer}</span><ArrowIcon /></div></article>
