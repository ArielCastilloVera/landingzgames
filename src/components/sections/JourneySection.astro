---
import { siteContent } from '../../data/site';
import BrandIcon from '../ui/BrandIcon.astro';
const { journey } = siteContent;
---

<section class="section journey-section" id="journey" aria-labelledby="journey-title">
  <div class="container">
    <div class="section-heading section-heading--stacked">
      <div>
        <p class="eyebrow">
          <span class="section-number">02</span>
          {journey.eyebrow}
        </p>
        <h2 id="journey-title">{journey.title}</h2>
      </div>
      <p class="section-intro">{journey.intro}</p>
    </div>
    <ol class="journey-list">
      {journey.steps.map((step) => (
        <li class="journey-step">
          <span class="journey-step__number">{step.number}</span>
          <BrandIcon name="arrow" className="journey-step__arrow" width={15} height={18} />
          <h3>{step.title}</h3>
          <p>{step.detail}</p>
        </li>
      ))}
    </ol>
    <div class="journey-gallery">
      <figure class="journey-gallery__item">
        <img
          src="/images/landing/customer-journey.webp"
          alt="Aficionados llegan juntos a una zona iluminada del estadio"
          width="1672"
          height="941"
          loading="lazy"
        />
        <figcaption>
          LA EXPERIENCIA DEL JUGADOR <span>CONTEXTO / 01</span>
        </figcaption>
      </figure>
      <p>
        Este mapa muestra puntos de contacto conectados; no promete una automatización integral.
        La disponibilidad de productos y las conexiones con proveedores dependen de la
        configuración de cada operador.
      </p>
    </div>
  </div>
</section>
