---
import { siteContent } from '../../data/site';
import { getImage, Picture } from 'astro:assets';
import logoAtlas from '../../assets/logos/logoslabgaming.png';
import logoSpriteTemplate from '../../assets/main.svg?raw';
import ecosystemPlatform from '../../assets/landing/ecosystem-platform.webp';
import playersImage from '../../assets/landing/imagen1gmb.png';
import operationImage from '../../assets/landing/imagen2gmb.png';
import engagementImage from '../../assets/landing/imagen3gmb.png';
import insightImage from '../../assets/landing/imagen4gmb.png';

const { ecosystem } = siteContent;
const ecosystemCardImages = {
  players: playersImage,
  operation: operationImage,
  engagement: engagementImage,
  insight: insightImage,
} as const;
const optimizedLogoAtlas = await getImage({
  src: logoAtlas,
  width: 2400,
  format: 'webp',
  quality: 82,
});
const logoSprite = logoSpriteTemplate.replaceAll('__LOGO_ATLAS_URL__', optimizedLogoAtlas.src);
const tickerLogos = [
  'ecosystem-logo-01',
  'ecosystem-logo-02',
  'ecosystem-logo-03',
  'ecosystem-logo-04',
  'ecosystem-logo-05',
  'ecosystem-logo-06',
  'ecosystem-logo-07',
  'ecosystem-logo-08',
  'ecosystem-logo-09',
];
const capabilityIds = ['players', 'operation', 'engagement', 'insight'];
const productCardCopy = {
  Sorti: {
    description: 'Registro, verificación, apuestas y cuenta en la plataforma del operador.',
    keyPoints: [
      'IA para verificar identidad y tutoriales guiados.',
      'Sportsbook, casino, virtuales y promociones.',
    ],
    review: 'Reunir el recorrido del jugador en una misma experiencia facilita su seguimiento.',
    reviewer: 'Operador · ficticio',
  },
  BackOffice: {
    description: 'Dashboard configurable para administración y control operativo.',
    keyPoints: [
      'Usuarios, agentes, roles y promociones.',
      'Cargas y retiros con QR o código, según el operador.',
    ],
    review: 'Configurar el panel y los permisos desde un lugar ordena el trabajo diario.',
    reviewer: 'Operaciones · ficticio',
  },
  SortiEngage: {
    description: 'Campañas y recorridos de adquisición conectados al registro.',
    keyPoints: [
      'Landings y automatizaciones.',
      'Promociones y comunicaciones al jugador.',
    ],
    review: 'Conectar campañas al registro ordena el recorrido desde el primer contacto.',
    reviewer: 'Marketing · ficticio',
  },
  ZTickets: {
    description: 'CRM de chat empresarial para atención al cliente y gestión de tickets.',
    keyPoints: [
      'Solicitudes desde widget, Instagram, Facebook y WhatsApp.',
      'Asignación al equipo ATC y seguimiento de estado.',
    ],
    review: 'Asignar tickets y revisar su estado ordena el seguimiento de solicitudes.',
    reviewer: 'Atención · ficticio',
  },
  ZPay: {
    description: 'Capa de pagos y movimientos para la operación. Producto en desarrollo.',
    keyPoints: [
      'Integraciones según la configuración del operador.',
      'Disponibilidad sujeta a configuración.',
    ],
    review: 'Conectar pagos con la operación responde a una necesidad del equipo.',
    reviewer: 'Operador · ficticio',
  },
  'Science 365': {
    description: 'Indicadores de jugadores, apuestas, marketing, pagos y atención.',
    keyPoints: [
      'Segmentación, calidad de atención y rentabilidad.',
      'Alertas y vistas adaptables.',
    ],
    review: 'Ver indicadores de distintas áreas ayuda a entender mejor la operación.',
    reviewer: 'Analítica · ficticio',
  },
  Center: {
    description: 'Información administrativa y financiera conectada a la operación.',
    keyPoints: [
      'Cierres, conciliación y comisiones.',
      'Lectura conjunta con Science 365.',
    ],
    review: 'Cruzar cierres y conciliación con datos financieros ordena las revisiones.',
    reviewer: 'Finanzas · ficticio',
  },
} as const;
const productCards = ecosystem.groups.flatMap((group, groupIndex) =>
  group.products.map((product) => ({
    ...productCardCopy[product.name as keyof typeof productCardCopy],
    group,
    groupIndex,
    product,
  })),
);
---

<section class="section ecosystem-section" id="ecosystem" aria-labelledby="ecosystem-title">
  <div class="ecosystem-ticker" role="region" aria-label="Proveedores del ecosistema" tabindex="0">
    <Fragment set:html={logoSprite} />
    <div class="ecosystem-ticker__track">
      {[0, 1].map((copy) => (
        <div class="ecosystem-ticker__group" aria-hidden={copy === 1 ? 'true' : undefined}>
          {tickerLogos.map((logoId) => (
            <svg
              class="ecosystem-ticker__logo"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              role="presentation"
              aria-hidden="true"
              focusable="false"
              preserveAspectRatio="xMidYMid meet"
            >
              <use href={`#${logoId}`} xlink:href={`#${logoId}`} width="100%" height="100%" />
            </svg>
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          <span class="section-number">01</span>
          {ecosystem.eyebrow}
        </p>
        <h2 id="ecosystem-title">{ecosystem.title}</h2>
      </div>
      <p class="section-intro">{ecosystem.intro}</p>
    </div>
    <figure class="ecosystem-feature">
      <Picture
        src={ecosystemPlatform}
        formats={['webp']}
        widths={[480, 768, 1024, 1440]}
        sizes="(max-width: 700px) 100vw, 90vw"
        alt="Plataforma conceptual de gestión deportiva en una pantalla de escritorio"
        width={1440}
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        CONCEPTO DEL ECOSISTEMA / ILUSTRATIVO <span>ZGAMES / 01</span>
      </figcaption>
    </figure>
    <div class="ecosystem-map" aria-label={ecosystem.mapLabel}>
      <div class="ecosystem-map__axis" aria-hidden="true">
        <span>{ecosystem.axisStart}</span>
        <span>{ecosystem.axisEnd}</span>
      </div>
      <div class="ecosystem-carousel" role="region" aria-label="Productos del ecosistema">
        <div class="ecosystem-carousel__track">
          {[0, 1].map((copy) => (
            <div class="ecosystem-carousel__group" aria-hidden={copy === 1 ? 'true' : undefined} inert={copy === 1}>
              {productCards.map(({ group, groupIndex, product, description, keyPoints, review, reviewer }, cardIndex) => (
                <a
                  class:list={['ecosystem-card', `ecosystem-card--${group.id}`]}
                  href={`#capability-${capabilityIds[groupIndex]}`}
                  aria-label={`${product.name}. ${description} Ver capacidades de ${group.name}`}
                  tabindex={copy === 1 ? -1 : undefined}
                  draggable="false"
                >
                  <div class="ecosystem-card__visual">
                    <Picture
                      class="ecosystem-card__image"
                      src={ecosystemCardImages[group.id]}
                      formats={['webp']}
                      widths={[360, 640, 960]}
                      sizes="(max-width: 640px) 82vw, (max-width: 900px) 62vw, 54vw"
                      alt=""
                      width={1448}
                      height={1086}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                    <span class="ecosystem-card__number">{String(cardIndex + 1).padStart(2, '0')}</span>
                    <span class="ecosystem-card__category">{group.name}</span>
                  </div>
                  <div class="ecosystem-card__body">
                    <div class="ecosystem-card__rating" aria-label="Valoración simulada de 4.9 sobre 5">
                      <span aria-hidden="true">★</span>
                      <strong>4.9 / 5</strong>
                      <small>VALORACIÓN DE MUESTRA</small>
                    </div>
                    <h3 class="ecosystem-card__product-name">{product.name}</h3>
                    <p class="ecosystem-card__description">{description}</p>
                    <div class="ecosystem-card__key-points">
                      <h4>PUNTOS CLAVE</h4>
                      <ul>
                        {keyPoints.map((point) => <li>{point}</li>)}
                      </ul>
                    </div>
                    <aside class="ecosystem-card__highlight">
                      <span>RESEÑA SIMULADA</span>
                      <blockquote>“{review}”</blockquote>
                      <cite>{reviewer}</cite>
                    </aside>
                  </div>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
      <p class="diagram-note">{ecosystem.diagramNote}</p>
    </div>
  </div>
</section>

<script>
  import { initializeEcosystemTicker } from '../../scripts/ecosystem-ticker';
  import { initializeEcosystemCarousel } from '../../scripts/ecosystem-carousel';

  initializeEcosystemTicker();
  initializeEcosystemCarousel();
</script>
