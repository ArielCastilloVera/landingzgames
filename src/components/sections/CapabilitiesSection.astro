---
import { siteContent } from '../../data/site';
import { Picture } from 'astro:assets';
import operatorDashboard from '../../assets/landing/operator-dashboard.webp';
const { capabilities, partners } = siteContent;
const capabilityIds = ['players', 'operation', 'engagement', 'insight'];
---

<section
  class="section capabilities-section"
  id="capabilities"
  aria-labelledby="capabilities-title"
>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          <span class="section-number">03</span>
          {capabilities.eyebrow}
        </p>
        <h2 id="capabilities-title">{capabilities.title}</h2>
      </div>
      <p class="section-intro">{capabilities.intro}</p>
    </div>
    <div class="capability-grid">
      {capabilities.items.map((item, index) => (
        <article class="capability-card" id={`capability-${capabilityIds[index]}`}>
          <span class="capability-card__number">{item.number}</span>
          <h3>{item.name}</h3>
          <p class="capability-card__products">
            {item.products.map((product) => product.name).join(' · ')}
          </p>
          <p class="capability-card__description">{item.description}</p>
        </article>
      ))}
    </div>
    <figure class="operator-visual">
      <Picture
        src={operatorDashboard}
        formats={['webp']}
        widths={[480, 768, 1024, 1440]}
        sizes="(max-width: 700px) 100vw, 90vw"
        alt="Panel conceptual para operadores, con módulos oscuros de gestión de partidos y actividad de cuentas"
        width={1440}
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        ESPACIO DE TRABAJO DEL OPERADOR / VISTA CONCEPTUAL <span>ZGAMES / 03</span>
      </figcaption>
    </figure>
    <div class="partner-panel">
      <div>
        <p class="eyebrow">{partners.eyebrow}</p>
        <h3>{partners.title}</h3>
        <p>{partners.intro}</p>
      </div>
      <ul class="partner-list">
        {partners.categories.map((category) => (
          <li>{category}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
