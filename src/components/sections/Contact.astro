---
import { siteContent } from '../../data/site';
import ArrowIcon from '../ui/ArrowIcon.astro';
import SectionLabel from '../ui/SectionLabel.astro';
const { contact } = siteContent;
---

<section class="contact-section" id="contacto" aria-labelledby="contact-title">
  <div class="container">
    <SectionLabel number="04" label={contact.label} theme="light" />
    <div class="contact-grid">
      <div class="contact-intro">
        <h2 id="contact-title">
          {contact.title.map((line) => (
            <span>{line}</span>
          ))}
        </h2>
        <p>{contact.intro}</p>
        <div class="contact-symbols" aria-hidden="true">
          ✣ ✣ ✣
        </div>
      </div>
      <form class="lead-form" id="lead-form">
        <div class="field">
          <label for="name">{contact.fields.name.label}</label>
          <input
            id="name"
            name="name"
            placeholder={contact.fields.name.placeholder}
            required
            maxlength="100"
          />
        </div>
        <div class="field">
          <label for="email">{contact.fields.email.label}</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder={contact.fields.email.placeholder}
            required
            maxlength="160"
          />
        </div>
        <div class="field field--full">
          <label for="company">{contact.fields.company.label}</label>
          <input
            id="company"
            name="company"
            placeholder={contact.fields.company.placeholder}
            maxlength="150"
          />
        </div>
        <div class="field field--full">
          <label for="message">{contact.fields.message.label}</label>
          <textarea
            id="message"
            name="message"
            placeholder={contact.fields.message.placeholder}
            rows="3"
            required
            maxlength="2000"
          ></textarea>
        </div>
        <div class="form-action">
          <button class="button button--dark" type="submit">
            <span>{contact.submitLabel}</span>
            <ArrowIcon />
          </button>
          <p>{contact.note}</p>
        </div>
        <p class="form-feedback" id="form-feedback" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </div>
</section>
<script define:vars={{ success: contact.success }}>
  const form = document.querySelector < HTMLFormElement > '#lead-form';
  const feedback = document.querySelector < HTMLElement > '#form-feedback';
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !feedback) return;
    feedback.hidden = false;
    feedback.textContent = success;
  });
</script>
