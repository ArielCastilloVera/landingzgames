---
import { siteContent } from '../../data/site';
import ArrowIcon from '../ui/ArrowIcon.astro';
import MenuIcon from '../ui/MenuIcon.astro';
const { brand, navigation, contact } = siteContent;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand-logo" href="#top" aria-label={`Volver al inicio de ${brand.name}`}>
      <svg viewBox="894.931 755.488 439.144 125.012" aria-hidden="true" focusable="false">
        <path
          fill="#e5e5e5"
          fill-rule="nonzero"
          d="M1046.542 832.486h15.778v-28.005h-15.778c-3.846 0-5.621 1.775-5.621 5.621v16.763c0 3.747 1.775 5.621 5.621 5.621m-18.045 20.313h28.201c3.649 0 5.622-1.676 5.622-5.226v-12.721l-6.41 7.889c-1.578 1.775-3.452 2.663-5.916 2.663h-9.27c-9.565 0-14.199-4.733-14.199-14.2v-25.441c0-9.565 4.634-14.2 14.199-14.2h9.27c2.464 0 4.338.789 5.916 2.564l6.41 7.889v-10.453h14.397v59.954c0 9.565-4.635 14.2-14.201 14.2h-34.019z"
        />
        <path
          fill="#e5e5e5"
          fill-rule="nonzero"
          d="M1104.718 832.486h15.778v-28.005h-15.778c-3.846 0-5.62 1.775-5.62 5.621v16.763c0 3.747 1.774 5.621 5.62 5.621m-20.017-26.723c0-9.565 4.634-14.2 14.199-14.2h9.27c2.464 0 4.338.789 5.916 2.564l6.41 7.889v-10.453h14.397v53.841h-14.397v-10.552l-6.41 7.889c-1.578 1.775-3.452 2.663-5.916 2.663h-9.27c-9.565 0-14.199-4.733-14.199-14.2z"
        />
        <path
          fill="#e5e5e5"
          fill-rule="nonzero"
          d="M1142.768 791.563h14.397v10.453l6.409-7.889c1.579-1.775 3.452-2.564 5.917-2.564h7.297c8.184 0 12.425 3.55 12.622 10.453l6.509-7.889c1.478-1.775 3.45-2.564 5.817-2.564h5.719c9.565 0 14.299 4.635 14.299 14.2v39.641h-14.495v-35.302c0-3.846-1.776-5.621-5.622-5.621h-12.227v40.923h-14.397V808.13c0-2.663-1.381-3.649-4.043-3.649h-13.805v40.923h-14.397z"
        />
        <path
          fill="#e5e5e5"
          fill-rule="nonzero"
          d="M1265.137 814.243v-4.142c0-3.845-1.873-5.62-5.62-5.62h-10.157c-3.846 0-5.621 1.775-5.621 5.62v4.142zm-35.794-8.48c0-9.565 4.634-14.2 14.199-14.2h21.792c9.566 0 14.201 4.635 14.201 14.2v16.862h-35.796v4.24c0 3.747 1.775 5.621 5.621 5.621h28.202v12.917h-34.02c-9.565 0-14.199-4.733-14.199-14.199z"
        />
        <path
          fill="#e5e5e5"
          fill-rule="nonzero"
          d="M1287.123 832.486h27.118c2.958 0 4.339-1.479 4.339-4.437v-.987c0-2.958-1.381-4.437-4.339-4.437h-15.186c-9.368 0-14.003-4.536-14.003-13.904v-2.958c0-9.565 4.635-14.2 14.2-14.2h31.752v12.918h-27.117c-2.959 0-4.438 1.381-4.438 4.339v1.085c0 2.958 1.479 4.338 4.438 4.338h15.186c9.367 0 14.002 4.635 14.002 14.003v2.958c0 9.467-4.733 14.2-14.298 14.2h-31.654z"
        />
        <path
          fill="#42c148"
          fill-rule="nonzero"
          d="m999.516 834.302-26.82 3.604 45.864-32.941v-13.482l-107.017-32.798v40.905l34.631 3.98.044-10.816 36.066 6.422-86.029 47.109V879.5l122.305-34.02v-20.768l-19.044 1.012z"
        />
        <path
          fill="#42c148"
          fill-rule="nonzero"
          d="M901.865 767.343c-3.256 0-4.74-2.569-4.74-4.83 0-2.262 1.484-4.849 4.74-4.849 3.238 0 4.685 2.587 4.685 4.849 0 2.261-1.447 4.83-4.685 4.83m0-10.855c-3.492 0-5.934 2.605-5.934 6.025s2.442 6.024 5.934 6.024 5.898-2.605 5.898-6.024-2.406-6.025-5.898-6.025"
        />
        <path
          fill="#42c148"
          fill-rule="nonzero"
          d="M902.263 762.332h-1.556v-1.664h1.556c.416 0 .814.325.814.832 0 .524-.398.832-.814.832m2.081-.832c0-1.303-.977-2.026-1.882-2.026h-3.003v6.187h1.248v-2.099h1.031l1.303 2.099h1.429l-1.375-2.207c.669-.272 1.249-.941 1.249-1.954"
        />
      </svg>
    </a>
    <div class="navigation-menu">
      <button
        type="button"
        class="navigation-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="main-navigation"
      >
        <MenuIcon expanded={false} />
      </button>
      <nav class="main-navigation" id="main-navigation" aria-label="Navegación principal">
        {navigation.map((item) => (
          <a href={item.href} aria-current={item.href === '#top' ? 'location' : undefined}>
            {item.label}
          </a>
        ))}
        <a class="button button--small" href="#contact">
          {contact.navAction}
          <ArrowIcon />
        </a>
      </nav>
    </div>
  </div>
</header>
