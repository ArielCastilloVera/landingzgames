---
import { siteContent } from '../../data/site';
import BrandIcon from '../ui/BrandIcon.astro';
import altenarLogo from '../../assets/logos/altenar.webp';
import pragmaticLogo from '../../assets/logos/pragmatic.webp';
import qtechLogo from '../../assets/logos/qtech.webp';
import timelessLogo from '../../assets/logos/timeless.webp';
const { ecosystem } = siteContent;
const partnerLogos = [
  { name: 'Altenar', image: altenarLogo },
  { name: 'Pragmatic Play', image: pragmaticLogo },
  { name: 'QTech Games', image: qtechLogo },
  { name: 'Timeless', image: timelessLogo },
];
const tickerLogos = Array.from({ length: 4 }, () => partnerLogos).flat();
---

<section class="section ecosystem-section" id="ecosystem" aria-labelledby="ecosystem-title">
  <div class="ecosystem-ticker" role="region" aria-label="Proveedores del ecosistema" tabindex="0">
    <div class="ecosystem-ticker__track">
      {[0, 1].map((copy) => (
        <div class="ecosystem-ticker__group" aria-hidden={copy === 1 ? 'true' : undefined}>
          {tickerLogos.map(({ name, image }, index) => (
            <img
              class="ecosystem-ticker__logo"
              src={image.src}
              alt={copy === 0 && index < partnerLogos.length ? name : ''}
              width={image.width}
              height={image.height}
              loading="eager"
              decoding="async"
            />
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          <span class="section-number">01</span>
          {ecosystem.eyebrow}
        </p>
        <h2 id="ecosystem-title">{ecosystem.title}</h2>
      </div>
      <p class="section-intro">{ecosystem.intro}</p>
    </div>
    <figure class="ecosystem-feature">
      <img
        src="/images/landing/ecosystem-platform.webp"
        alt="Plataforma conceptual de gestión deportiva en una pantalla de escritorio"
        width="1672"
        height="941"
        loading="lazy"
      />
      <figcaption>
        CONCEPTO DEL ECOSISTEMA / ILUSTRATIVO <span>ZGAMES / 01</span>
      </figcaption>
    </figure>
    <div class="ecosystem-map" aria-label={ecosystem.mapLabel}>
      <div class="ecosystem-map__axis" aria-hidden="true">
        <span>{ecosystem.axisStart}</span>
        <span>{ecosystem.axisEnd}</span>
      </div>
      <div class="ecosystem-groups">
        {ecosystem.groups.map((group) => (
          <article class:list={['ecosystem-card', `ecosystem-card--${group.id}`]}>
            <div class="ecosystem-card__top">
              <span>{group.number}</span>
              <span>{group.name}</span>
            </div>
            <BrandIcon name="parallelogram" className="ecosystem-card__mark" />
            <div class="product-list">
              {group.products.map((product) => (
                <span class="product-chip">{product.name}</span>
              ))}
            </div>
            <p>{group.description}</p>
            {group.note && <small class="development-note">{group.note}</small>}
          </article>
        ))}
      </div>
      <p class="diagram-note">{ecosystem.diagramNote}</p>
    </div>
  </div>
</section>

<script>
  import { initializeEcosystemTicker } from '../../scripts/ecosystem-ticker';

  initializeEcosystemTicker();
</script>
