---
import { siteContent } from '../../data/site';
import logo from '../../assets/logos/download.webp';
import ArrowIcon from '../ui/ArrowIcon.astro';
const { brand, footer } = siteContent;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="brand-logo" href="#top" aria-label={`Volver al inicio de ${brand.name}`}>
      <img src={logo.src} alt="" width={logo.width} height={logo.height} loading="lazy" />
    </a>
    <p>{brand.tagline}</p>
    <a class="back-to-top" href="#top">
      {footer.backToTop}
      <ArrowIcon direction="up" />
    </a>
  </div>
</footer>
