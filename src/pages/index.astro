---
import { siteContent } from '../data/site';
import '../styles/global.css';

const { brand, navigation, hero, ecosystem, journey, capabilities, partners, contact } =
  siteContent;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Explore the ZGames connected technology ecosystem for gaming operators."
    />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>ZGAMES | A connected technology ecosystem</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="#top" aria-label={`${brand.name} home`}>
          {brand.name}
        </a>

        <details class="navigation-menu">
          <summary class="navigation-toggle">Menu</summary>
          <nav class="main-navigation" aria-label="Main navigation">
            {navigation.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
            <a class="button button--small" href="#contact">
              Talk to our team
            </a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="container hero-layout">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="status-dot"></span>
              {hero.eyebrow}
            </p>
            <h1 id="hero-title">{hero.title}</h1>
            <p class="hero-description">{hero.body}</p>
            <div class="hero-actions">
              <a class="button" href="#contact">
                {hero.primaryAction}
              </a>
              <a class="text-link" href="#ecosystem">
                {hero.secondaryAction}
                <span aria-hidden="true">↘</span>
              </a>
            </div>
          </div>
          <figure class="hero-image">
            <img
              src="/images/football-journey.jpg"
              alt="A football player moving with the ball across a lit stadium pitch"
              width="1600"
              height="900"
              fetchpriority="high"
            />
            <figcaption>
              <span>Connected around the player</span>
              <span>ZGAMES / 01</span>
            </figcaption>
          </figure>
        </div>
        <div class="container hero-note">
          <span>PLAYER EXPERIENCE</span>
          <span class="hero-note-line" aria-hidden="true"></span>
          <span>OPERATOR TOOLS</span>
          <span class="hero-note-line" aria-hidden="true"></span>
          <span>DATA &amp; SUPPORT</span>
        </div>
      </section>

      <section class="section ecosystem-section" id="ecosystem" aria-labelledby="ecosystem-title">
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                <span class="section-number">01</span>
                {ecosystem.eyebrow}
              </p>
              <h2 id="ecosystem-title">{ecosystem.title}</h2>
            </div>
            <p class="section-intro">{ecosystem.intro}</p>
          </div>

          <div class="ecosystem-map" aria-label="ZGames ecosystem product groups">
            <div class="ecosystem-map__axis" aria-hidden="true">
              <span>Player experience</span>
              <span>Operator capabilities</span>
            </div>
            <div class="ecosystem-groups">
              {ecosystem.groups.map((group) => (
                <article class:list={['ecosystem-card', `ecosystem-card--${group.id}`]}>
                  <div class="ecosystem-card__top">
                    <span>{group.number}</span>
                    <span>{group.name}</span>
                  </div>
                  <div class="product-list">
                    {group.products.map((product) => (
                      <span class="product-chip">{product}</span>
                    ))}
                  </div>
                  <p>{group.description}</p>
                  {'note' in group && <small class="development-note">{group.note}</small>}
                </article>
              ))}
            </div>
            <p class="diagram-note">
              Products are shown by role in the ecosystem; operator configurations may differ.
            </p>
          </div>
        </div>
      </section>

      <section class="section journey-section" id="journey" aria-labelledby="journey-title">
        <div class="container">
          <div class="section-heading section-heading--stacked">
            <div>
              <p class="eyebrow">
                <span class="section-number">02</span>
                {journey.eyebrow}
              </p>
              <h2 id="journey-title">{journey.title}</h2>
            </div>
            <p class="section-intro">{journey.intro}</p>
          </div>

          <ol class="journey-list">
            {journey.steps.map((step) => (
              <li class="journey-step">
                <span class="journey-step__number">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.detail}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section
        class="section capabilities-section"
        id="capabilities"
        aria-labelledby="capabilities-title"
      >
        <div class="container">
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                <span class="section-number">03</span>
                {capabilities.eyebrow}
              </p>
              <h2 id="capabilities-title">{capabilities.title}</h2>
            </div>
            <p class="section-intro">A joined-up view, with each product’s role kept clear.</p>
          </div>

          <div class="capability-grid">
            {capabilities.items.map((item) => (
              <article class="capability-card">
                <span class="capability-card__number">{item.number}</span>
                <h3>{item.name}</h3>
                <p class="capability-card__products">{item.products}</p>
                <p class="capability-card__description">{item.description}</p>
              </article>
            ))}
          </div>

          <div class="partner-panel">
            <div>
              <p class="eyebrow">{partners.eyebrow}</p>
              <h3>{partners.title}</h3>
              <p>{partners.intro}</p>
            </div>
            <ul class="partner-list">
              {partners.categories.map((category) => (
                <li>{category}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="container contact-layout">
          <div>
            <p class="eyebrow">
              <span class="section-number">04</span>
              {contact.eyebrow}
            </p>
            <h2 id="contact-title">{contact.title}</h2>
          </div>
          <div class="contact-copy">
            <p>{contact.body}</p>
            <p>{contact.prompt}</p>
            <a class="text-link" href="#ecosystem">
              {contact.action}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="wordmark" href="#top">
          {brand.name}
        </a>
        <p>{brand.tagline}</p>
        <a class="back-to-top" href="#top">
          Back to top ↑
        </a>
      </div>
    </footer>

    <script>
      const navigationMenu = document.querySelector<HTMLDetailsElement>('.navigation-menu');
      navigationMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => navigationMenu.removeAttribute('open'));
      });
    </script>
  </body>
</html>
