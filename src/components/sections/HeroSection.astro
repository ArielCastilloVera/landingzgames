---
import { siteContent } from '../../data/site';
import { Picture } from 'astro:assets';
import backgroundHero from '../../assets/backgrounds/backgroundhero1.webp';
import heroImage from '../../assets/heroimgs/heroimage.png';
import ArrowIcon from '../ui/ArrowIcon.astro';

const { hero } = siteContent;
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero-panel>
  <div class="container">
    <div class="hero-stage" style={`--hero-pattern: url("${backgroundHero.src}")`}>
      <div class="hero-stage__pattern" aria-hidden="true"></div>
      <h1 id="hero-title">
        <span>BET.</span>
        <span>PLAY.</span>
        <span class="hero-title__win">WIN.</span>
      </h1>

      <figure class="hero-visual">
        <Picture
          src={heroImage}
          formats={['webp']}
          widths={[480, 768, 1024, 1440]}
          sizes="(max-width: 700px) 100vw, 64vw"
          alt="Jugador de fútbol remata al arco, rodeado de cuotas deportivas en vivo."
          width={1440}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption class="hero-image-tag">
          <span>ZGAMES</span> / CREADO PARA LA SIGUIENTE JUGADA
        </figcaption>
        <div class="hero-image-corners" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </figure>
      <span class="hero-stage__index" aria-hidden="true">
        APUESTAS DEPORTIVAS <b>×</b> ENTRETENIMIENTO
      </span>
    </div>

    <div class="hero-bottom">
      <div class="hero-intro">
        <strong>Una nueva forma de construir el juego.</strong>
        <p>{hero.body}</p>
      </div>
      <div class="hero-actions">
        <a class="button" href="#contact">
          {hero.primaryAction}
          <ArrowIcon />
        </a>
        <a class="text-link" href="#ecosystem">
          {hero.secondaryAction}
          <ArrowIcon direction="down-right" />
        </a>
      </div>
    </div>

    <div class="hero-index">
      <span>DISEÑADO PARA TU OPERACIÓN</span>
      <a href="#ecosystem">
        EXPLORAR EL ECOSISTEMA <ArrowIcon direction="down-right" />
      </a>
    </div>
  </div>
</section>
