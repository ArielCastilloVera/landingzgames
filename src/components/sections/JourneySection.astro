---
import { siteContent } from '../../data/site';
const { journey } = siteContent;
---

<section class="section journey-section" id="journey" aria-labelledby="journey-title">
  <div class="container">
    <div class="section-heading section-heading--stacked">
      <div>
        <p class="eyebrow">
          <span class="section-number">02</span>
          {journey.eyebrow}
        </p>
        <h2 id="journey-title">{journey.title}</h2>
      </div>
      <p class="section-intro">{journey.intro}</p>
    </div>
    <ol class="journey-list">
      {journey.steps.map((step) => (
        <li class="journey-step">
          <span class="journey-step__number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.detail}</p>
        </li>
      ))}
    </ol>
    <div class="journey-gallery">
      <figure class="journey-gallery__item">
        <img
          src="/images/landing/customer-journey.webp"
          alt="Football supporters arriving together at an illuminated stadium concourse"
          width="1672"
          height="941"
          loading="lazy"
        />
        <figcaption>
          THE PLAYER EXPERIENCE <span>CONTEXT / 01</span>
        </figcaption>
      </figure>
      <p>
        This is a map of connected touchpoints, not a promise of end-to-end automation. Product
        availability and provider connections depend on each operator’s setup.
      </p>
    </div>
  </div>
</section>
