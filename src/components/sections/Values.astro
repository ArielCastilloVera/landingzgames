---
import { siteContent } from '../../data/site'; import SectionLabel from '../ui/SectionLabel.astro'; import ValueCard from '../cards/ValueCard.astro';
const { values } = siteContent;
---
<section class="values-section" id="adn" aria-labelledby="values-title"><div class="container"><SectionLabel number="02" label={values.label} /><div class="section-heading"><h2 id="values-title">{values.title.map((line) => <span>{line}</span>)}</h2><p>{values.intro}</p></div><div class="values-grid">{values.items.map((item) => <ValueCard {...item} />)}</div></div></section>
