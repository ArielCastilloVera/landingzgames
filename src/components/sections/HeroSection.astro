---
import { siteContent } from '../../data/site';
import ArrowIcon from '../ui/ArrowIcon.astro';
import BrandIcon from '../ui/BrandIcon.astro';
const { hero } = siteContent;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-layout">
    <div class="hero-copy">
      <p class="eyebrow"></p>
      <h1 id="hero-title">{hero.title}</h1>
      <p class="hero-description">{hero.body}</p>
      <div class="hero-actions">
        <a class="button" href="#contact">
          {hero.primaryAction}
          <ArrowIcon />
        </a>
        <a class="text-link" href="#ecosystem">
          {hero.secondaryAction}
          <ArrowIcon direction="down-right" />
        </a>
      </div>
    </div>
    <figure class="hero-image">
      <img
        src="/images/landing/hero-ecosystem.webp"
        alt="A night football stadium with the pitch, crowd, and match action illuminated in green"
        width="1912"
        height="823"
        fetchpriority="high"
      />
      <figcaption>
        <span>{hero.imageCaption}</span>
        <span>{hero.imageCredit}</span>
      </figcaption>
    </figure>
  </div>
  <nav class="hero-index container" aria-label="Page sections">
    <a href="#ecosystem">
      <span>01</span> The ecosystem
    </a>
    <a href="#journey">
      <span>02</span> The player journey
    </a>
    <a href="#capabilities">
      <span>03</span> Operator capabilities
    </a>
    <a href="#contact">
      <span>04</span> Let’s talk
    </a>
  </nav>
  <div class="container hero-note">
    {hero.highlights.map((highlight, index) => (
      <Fragment>
        <span>{highlight}</span>
        {index < hero.highlights.length - 1 && (
          <span class="hero-note-line" aria-hidden="true"></span>
        )}
      </Fragment>
    ))}
  </div>
</section>
