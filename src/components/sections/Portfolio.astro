---
import { siteContent } from '../../data/site';
import SectionLabel from '../ui/SectionLabel.astro';
import PortfolioCard from '../cards/PortfolioCard.astro';
const { portfolio } = siteContent;
---

<section class="portfolio-section" id="universo" aria-labelledby="portfolio-title">
  <div class="container">
    <SectionLabel number="03" label={portfolio.label} />
    <div class="section-heading">
      <h2 id="portfolio-title">
        {portfolio.title.map((line) => (
          <span>{line}</span>
        ))}
      </h2>
      <p>{portfolio.intro}</p>
    </div>
    <div class="portfolio-grid">
      {portfolio.items.map((item) => (
        <PortfolioCard {...item} />
      ))}
    </div>
  </div>
</section>
