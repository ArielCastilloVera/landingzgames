---
import { siteContent } from '../../data/site';
import MenuIcon from '../ui/MenuIcon.astro';
const { brand, navigation, contact } = siteContent;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="#top" aria-label={`${brand.name} home`}>
      {brand.name}
    </a>
    <details class="navigation-menu">
      <summary
        class="navigation-toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="main-navigation"
      >
        <MenuIcon expanded={false} />
      </summary>
      <nav class="main-navigation" id="main-navigation" aria-label="Main navigation">
        {navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a class="button button--small" href="#contact">
          {contact.navAction}
        </a>
      </nav>
    </details>
  </div>
</header>
