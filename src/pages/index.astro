---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import EcosystemSection from '../components/sections/EcosystemSection.astro';
import JourneySection from '../components/sections/JourneySection.astro';
import CapabilitiesSection from '../components/sections/CapabilitiesSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<SiteLayout>
  <div class="hero-scroll-track" data-hero-scroll-track>
    <HeroSection />
    <EcosystemSection />
  </div>
  <JourneySection />
  <CapabilitiesSection />
  <ContactSection />
</SiteLayout>

<script>
  import { initializeHeroScrollAnimation } from '../scripts/hero-scroll-animation';

  initializeHeroScrollAnimation();
</script>
